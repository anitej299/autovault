{
  "name": "autovault",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "format": "prettier --write .",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:test:migrate": "node scripts/test-database.mjs",
    "pretest:e2e": "npm run db:test:migrate && npm run build",
    "pretest": "npm run db:test:migrate",
    "pretest:coverage": "npm run db:test:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.2.1",
    "eslint": "10.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5",
    "vite": "7.3.7"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "postcss-selector-parser": "7.1.6"
  }
}
